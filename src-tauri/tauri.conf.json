{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YDLite",
  "version": "0.1.0",
  "identifier": "com.ydlite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YDLite",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#edf1f6"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
